exports[`generateCode > RGB LED + onboard RGB on the ESP32-C6 1`] = `
"// Circuito Vivo — Prueba — ESP32-C6-DevKitC-1
// LED RGB 1 → R: GPIO4, G: GPIO5, B: GPIO6

// ── Pines (según tus conexiones) ────────────────────────────────
const int LED_RGB_1_R = 4;  // LED RGB 1 (R)
const int LED_RGB_1_G = 5;  // LED RGB 1 (G)
const int LED_RGB_1_B = 6;  // LED RGB 1 (B)

// ── Variables ───────────────────────────────────────────────────
double azul = 128;

// ── Funciones de ayuda (generadas automáticamente) ──────────────
// Ajusta un valor al rango 0..255 que entiende analogWrite()
int cv_pwm(double value) {
  return (int) round(constrain(value, 0, 255));
}

void setup() {
  // Configuración automática según tu circuito
  pinMode(LED_RGB_1_R, OUTPUT);  // LED RGB 1 (R): salida
  pinMode(LED_RGB_1_G, OUTPUT);  // LED RGB 1 (G): salida
  pinMode(LED_RGB_1_B, OUTPUT);  // LED RGB 1 (B): salida
}

void loop() {
  analogWrite(LED_RGB_1_R, 255);           // LED RGB 1: rojo
  analogWrite(LED_RGB_1_G, 0);             // LED RGB 1: verde
  analogWrite(LED_RGB_1_B, cv_pwm(azul));  // LED RGB 1: azul
  rgbLedWrite(RGB_BUILTIN, 0, 0, 255);     // color del LED integrado
  delay(500);                              // espera 500 ms
  rgbLedWrite(RGB_BUILTIN, 0, 0, 0);       // LED integrado apagado
  delay(500);                              // espera 500 ms
}
"
`;

exports[`generateCode > blink on the ESP32-C6 1`] = `
"// Circuito Vivo — Parpadeo — ESP32-C6-DevKitC-1
// LED 1 → GPIO4 (a través de R1)

// ── Pines (según tus conexiones) ────────────────────────────────
const int LED_1 = 4;  // LED 1

void setup() {
  // Configuración automática según tu circuito
  pinMode(LED_1, OUTPUT);  // LED 1: salida
}

void loop() {
  digitalWrite(LED_1, HIGH);  // enciende LED 1
  delay(500);                 // espera 500 ms
  digitalWrite(LED_1, LOW);   // apaga LED 1
  delay(500);                 // espera 500 ms
}
"
`;

