exports[`generateCode > button with INPUT_PULLUP (active low) 1`] = `
"// Circuito Vivo — Prueba — Arduino Uno R3
// Botón 1 → pin 2
// LED 1 → pin 13

// ── Pines (según tus conexiones) ────────────────────────────────
const int BOTON_1 = 2;  // Botón 1
const int LED_1 = 13;   // LED 1

// ── Funciones de ayuda (generadas automáticamente) ──────────────
// Botón 1: devuelve true UNA sola vez por cada pulsación (antirrebote de 30 ms)
bool clicked_BOTON_1() {
  static bool previous = false;         // ¿estaba presionado la vez anterior?
  static unsigned long lastChange = 0;  // cuándo cambió por última vez (ms)
  bool pressed = (digitalRead(BOTON_1) == LOW);
  if (pressed != previous && millis() - lastChange >= 30) {
    previous = pressed;
    lastChange = millis();
    return pressed;  // true solo al presionar, no al soltar
  }
  return false;
}

void setup() {
  // Configuración automática según tu circuito
  Serial.begin(9600);              // abre el Monitor Serie a 9600 baudios
  pinMode(BOTON_1, INPUT_PULLUP);  // Botón 1: entrada con resistencia pull-up interna
  pinMode(LED_1, OUTPUT);          // LED 1: salida
}

void loop() {
  if (digitalRead(BOTON_1) == LOW) {
    digitalWrite(LED_1, HIGH);  // enciende LED 1
  } else {
    digitalWrite(LED_1, LOW);  // apaga LED 1
  }
  if (clicked_BOTON_1()) {
    Serial.println("¡Clic!");
  }
}
"
`;

exports[`generateCode > numeric model: real division, fmod, int promotion, for both ways 1`] = `
"// Circuito Vivo — Prueba — Arduino Uno R3

// ── Variables ───────────────────────────────────────────────────
double x = 0;
bool listo = false;
double i = 0;

// ── Funciones de ayuda (generadas automáticamente) ──────────────
// Muestra un número en el Monitor Serie: sin decimales si es entero (3), con 2 decimales si no (3.14)
void cvPrint(double value) {
  if (fabs(value) < 2000000000.0 && value == (long) value) Serial.print((long) value);
  else Serial.print(value, 2);
}
void cvPrintln(double value) {
  cvPrint(value);
  Serial.println();
}

// Muestra un valor lógico como «verdadero» o «falso»
void cvPrint(bool value) {
  Serial.print(value ? "verdadero" : "falso");
}
void cvPrintln(bool value) {
  cvPrint(value);
  Serial.println();
}

// División segura: si el divisor es 0 el resultado es 0 (en vez de un valor inválido)
double cv_div(double a, double b) {
  return b == 0 ? 0 : a / b;
}

void setup() {
  // Configuración automática según tu circuito
  Serial.begin(9600);  // abre el Monitor Serie a 9600 baudios
  pinMode(7, OUTPUT);  // pin 7: salida (agregado automáticamente)

  x = 7 / 2.0;
  x = cv_div(x, x);
  x = fmod(x, 3);
  x = analogRead(A0) * 100.0;
  x = millis() - 5000.0;
  listo = x > 3 && (true || false);
  for (i = 10; i >= 1; i -= 2) {
    cvPrintln(i);
  }
  {  // i cuenta hacia arriba o hacia abajo según los límites
    double iDesde = 1, iHasta = x, iPaso = 1;
    if (iDesde > iHasta) iPaso = -iPaso;
    for (i = iDesde; iPaso > 0 ? i <= iHasta : i >= iHasta; i += iPaso) {
      break;
    }
  }
  cvPrintln(listo);
  digitalWrite(7, listo ? HIGH : LOW);
}

void loop() {
  // Agrega bloques en «repetir para siempre»: se ejecutan una y otra vez
}
"
`;

exports[`generateCode > servo + potentiometer (include, attach, cv_map) 1`] = `
"// Circuito Vivo — Prueba — Arduino Uno R3
// Potenciómetro 1 → pin A0
// Servo 1 → pin 9

#include <Servo.h>

// ── Pines (según tus conexiones) ────────────────────────────────
const int POTENCIOMETRO_1 = A0;  // Potenciómetro 1
const int SERVO_1 = 9;           // Servo 1

// ── Servos ──────────────────────────────────────────────────────
Servo servo1;  // Servo 1

// ── Variables ───────────────────────────────────────────────────
double angulo = 0;

// ── Funciones de ayuda (generadas automáticamente) ──────────────
// Muestra un número en el Monitor Serie: sin decimales si es entero (3), con 2 decimales si no (3.14)
void cvPrint(double value) {
  if (fabs(value) < 2000000000.0 && value == (long) value) Serial.print((long) value);
  else Serial.print(value, 2);
}
void cvPrintln(double value) {
  cvPrint(value);
  Serial.println();
}

// Pasa un valor de un rango a otro, conservando los decimales (map() de Arduino solo usa enteros)
double cv_map(double value, double fromLow, double fromHigh, double toLow, double toHigh) {
  if (fromHigh == fromLow) return toLow;
  return (value - fromLow) * (toHigh - toLow) / (fromHigh - fromLow) + toLow;
}

// Convierte una lectura analógica (0..1023) en porcentaje (0..100 %)
double cv_percent(int raw) {
  return round(raw * 100.0 / 1023);
}

void setup() {
  // Configuración automática según tu circuito
  Serial.begin(9600);      // abre el Monitor Serie a 9600 baudios
  servo1.attach(SERVO_1);  // conecta Servo 1 a su pin
}

void loop() {
  angulo = cv_map(cv_percent(analogRead(POTENCIOMETRO_1)), 0, 100, 0, 180);
  servo1.write(constrain(angulo, 0, 180));  // mueve Servo 1
  cvPrintln(angulo);
  delay(15);  // espera 15 ms
}
"
`;

exports[`generateCode > traffic light with three LEDs and a counter 1`] = `
"// Circuito Vivo — Semáforo — Arduino Uno R3
// Rojo → pin 12
// Amarillo → pin 11
// Verde → pin 10

// ── Pines (según tus conexiones) ────────────────────────────────
const int ROJO = 12;      // Rojo
const int AMARILLO = 11;  // Amarillo
const int VERDE = 10;     // Verde

// ── Variables ───────────────────────────────────────────────────
double ciclos = 0;

// ── Funciones de ayuda (generadas automáticamente) ──────────────
// Muestra un número en el Monitor Serie: sin decimales si es entero (3), con 2 decimales si no (3.14)
void cvPrint(double value) {
  if (fabs(value) < 2000000000.0 && value == (long) value) Serial.print((long) value);
  else Serial.print(value, 2);
}
void cvPrintln(double value) {
  cvPrint(value);
  Serial.println();
}

void setup() {
  // Configuración automática según tu circuito
  Serial.begin(9600);         // abre el Monitor Serie a 9600 baudios
  pinMode(ROJO, OUTPUT);      // Rojo: salida
  pinMode(AMARILLO, OUTPUT);  // Amarillo: salida
  pinMode(VERDE, OUTPUT);     // Verde: salida
}

void loop() {
  digitalWrite(ROJO, HIGH);   // enciende Rojo
  delay(3000);                // espera 3 segundos
  digitalWrite(ROJO, LOW);    // apaga Rojo
  digitalWrite(VERDE, HIGH);  // enciende Verde
  delay(2500);                // espera 2,5 segundos
  digitalWrite(VERDE, LOW);   // apaga Verde
  for (int i = 0; i < 3; i++) {
    digitalWrite(AMARILLO, HIGH);  // enciende Amarillo
    delay(250);                    // espera 250 ms
    digitalWrite(AMARILLO, LOW);   // apaga Amarillo
    delay(250);                    // espera 250 ms
  }
  ciclos++;
  Serial.print("Ciclos: ");
  cvPrintln(ciclos);
}
"
`;

