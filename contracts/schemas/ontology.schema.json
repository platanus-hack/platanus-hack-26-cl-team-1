{
  "$defs": {
    "ActionDef": {
      "additionalProperties": false,
      "description": "One atomic, visible action: `verb(object, target)`.\n\n`visual_cue` says what the action looks like on camera. It feeds the perception prompt and the\nvideo-generation prompt, so it must describe something a camera can see.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label_es": {
          "minLength": 1,
          "title": "Label Es",
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "verb": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Verb",
          "type": "string"
        },
        "visual_cue": {
          "minLength": 1,
          "title": "Visual Cue",
          "type": "string"
        }
      },
      "required": [
        "id",
        "verb",
        "label_es",
        "visual_cue"
      ],
      "title": "ActionDef",
      "type": "object"
    },
    "ObjectDef": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label_es": {
          "minLength": 1,
          "title": "Label Es",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label_es",
        "description"
      ],
      "title": "ObjectDef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/ActionDef"
      },
      "title": "Actions",
      "type": "array"
    },
    "domain": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Domain",
      "type": "string"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/ObjectDef"
      },
      "title": "Objects",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "domain",
    "version",
    "objects",
    "actions"
  ],
  "title": "Ontology",
  "type": "object"
}
