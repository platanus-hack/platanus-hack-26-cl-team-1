{
  "$defs": {
    "Quality": {
      "enum": [
        "ok",
        "bad",
        "unknown"
      ],
      "title": "Quality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "`action` is null when nothing from the task's action set is happening, or the model is unsure.\nA null action must come with quality `unknown`: the supervisor stays silent on it.",
  "properties": {
    "action": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Action"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "objects": {
      "default": [],
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Objects",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/Quality"
    }
  },
  "required": [
    "action",
    "confidence",
    "quality"
  ],
  "title": "VlmOutput",
  "type": "object"
}
