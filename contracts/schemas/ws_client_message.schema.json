{
  "$defs": {
    "Hello": {
      "additionalProperties": false,
      "properties": {
        "debug": {
          "default": false,
          "title": "Debug",
          "type": "boolean"
        },
        "protocol": {
          "const": 1,
          "default": 1,
          "title": "Protocol",
          "type": "integer"
        },
        "record": {
          "default": false,
          "title": "Record",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "task_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Task Id",
          "type": "string"
        },
        "type": {
          "const": "hello",
          "default": "hello",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "source"
      ],
      "title": "Hello",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "description": "Operator label during dataset recording (record=True only).",
      "properties": {
        "mistake_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mistake Id"
        },
        "step": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "type": {
          "const": "label",
          "default": "label",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "Label",
      "type": "object"
    },
    "Mute": {
      "additionalProperties": false,
      "properties": {
        "on": {
          "title": "On",
          "type": "boolean"
        },
        "type": {
          "const": "mute",
          "default": "mute",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "on"
      ],
      "title": "Mute",
      "type": "object"
    },
    "Reset": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "reset",
          "default": "reset",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "Reset",
      "type": "object"
    },
    "SkipStep": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skip_step",
          "default": "skip_step",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "SkipStep",
      "type": "object"
    },
    "Source": {
      "description": "Where the frames come from. The server treats both the same way.",
      "enum": [
        "sim",
        "webcam"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "hello": "#/$defs/Hello",
      "label": "#/$defs/Label",
      "mute": "#/$defs/Mute",
      "reset": "#/$defs/Reset",
      "skip_step": "#/$defs/SkipStep"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Hello"
    },
    {
      "$ref": "#/$defs/SkipStep"
    },
    {
      "$ref": "#/$defs/Reset"
    },
    {
      "$ref": "#/$defs/Mute"
    },
    {
      "$ref": "#/$defs/Label"
    }
  ]
}
