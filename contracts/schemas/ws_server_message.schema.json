{
  "$defs": {
    "CancelSay": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "cancel_say",
          "default": "cancel_say",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "CancelSay",
      "type": "object"
    },
    "Debug": {
      "additionalProperties": false,
      "properties": {
        "latency_ms": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Latency Ms",
          "type": "object"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Observation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "debug",
          "default": "debug",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "seq",
        "latency_ms",
        "observation"
      ],
      "title": "Debug",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "bad_message",
            "unknown_task",
            "protocol_version",
            "internal"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "title": "Error",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/MistakeKind"
        },
        "mistake_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mistake Id"
        },
        "step": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step"
        },
        "text_es": {
          "minLength": 1,
          "title": "Text Es",
          "type": "string"
        },
        "type": {
          "const": "issue",
          "default": "issue",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "step",
        "kind",
        "mistake_id",
        "text_es"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueClear": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step"
        },
        "type": {
          "const": "issue_clear",
          "default": "issue_clear",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "step"
      ],
      "title": "IssueClear",
      "type": "object"
    },
    "MistakeDef": {
      "additionalProperties": false,
      "description": "A task-specific mistake: what it looks like and what to say.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "correction_es": {
          "minLength": 1,
          "title": "Correction Es",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MistakeKind"
        },
        "step": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Step",
          "type": "string"
        },
        "visual_cue": {
          "minLength": 1,
          "title": "Visual Cue",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "step",
        "action",
        "description",
        "visual_cue",
        "correction_es"
      ],
      "title": "MistakeDef",
      "type": "object"
    },
    "MistakeKind": {
      "description": "Closed set of mistake types.\n\n`out_of_order` and `repeated` are detected generically from the step graph; `wrong_action` and\n`incomplete` need a `MistakeDef` in the task to say what they look like and how to correct them.",
      "enum": [
        "out_of_order",
        "wrong_action",
        "incomplete",
        "repeated"
      ],
      "title": "MistakeKind",
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/VlmOutput"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "t_ms",
        "source",
        "model",
        "latency_ms",
        "output"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "normal",
        "urgent"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Quality": {
      "enum": [
        "ok",
        "bad",
        "unknown"
      ],
      "title": "Quality",
      "type": "string"
    },
    "Ready": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Session Id",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/Task"
        },
        "type": {
          "const": "ready",
          "default": "ready",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "session_id",
        "task"
      ],
      "title": "Ready",
      "type": "object"
    },
    "Say": {
      "additionalProperties": false,
      "description": "Subtitle + voice. When `audio` is true a binary audio frame with the same id follows;\notherwise the browser may speak it with speechSynthesis.",
      "properties": {
        "audio": {
          "title": "Audio",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "normal"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "say",
          "default": "say",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "text",
        "priority",
        "audio"
      ],
      "title": "Say",
      "type": "object"
    },
    "Source": {
      "description": "Where the frames come from. The server treats both the same way.",
      "enum": [
        "sim",
        "webcam"
      ],
      "title": "Source",
      "type": "string"
    },
    "State": {
      "additionalProperties": false,
      "properties": {
        "next_steps": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Next Steps",
          "type": "array"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "statuses": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/StepStatus"
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Statuses",
          "type": "object"
        },
        "type": {
          "const": "state",
          "default": "state",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "seq",
        "statuses",
        "next_steps"
      ],
      "title": "State",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Action",
          "type": "string"
        },
        "completion_cue": {
          "minLength": 1,
          "title": "Completion Cue",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "instruction_es": {
          "minLength": 1,
          "title": "Instruction Es",
          "type": "string"
        },
        "min_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Duration S"
        },
        "requires": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "title_es": {
          "minLength": 1,
          "title": "Title Es",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title_es",
        "instruction_es",
        "action",
        "requires",
        "completion_cue",
        "min_duration_s"
      ],
      "title": "Step",
      "type": "object"
    },
    "StepStatus": {
      "enum": [
        "pending",
        "active",
        "done",
        "mistake"
      ],
      "title": "StepStatus",
      "type": "string"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "domain": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Domain",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "mistakes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MistakeDef"
          },
          "title": "Mistakes",
          "type": "array"
        },
        "objects": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "ontology_version": {
          "title": "Ontology Version",
          "type": "integer"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "title_es": {
          "minLength": 1,
          "title": "Title Es",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "title_es",
        "description",
        "domain",
        "ontology_version",
        "objects",
        "actions",
        "steps",
        "mistakes"
      ],
      "title": "Task",
      "type": "object"
    },
    "VlmOutput": {
      "additionalProperties": false,
      "description": "`action` is null when nothing from the task's action set is happening, or the model is unsure.\nA null action must come with quality `unknown`: the supervisor stays silent on it.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Action"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "objects": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        }
      },
      "required": [
        "action",
        "confidence",
        "quality",
        "objects",
        "note"
      ],
      "title": "VlmOutput",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "cancel_say": "#/$defs/CancelSay",
      "debug": "#/$defs/Debug",
      "error": "#/$defs/Error",
      "issue": "#/$defs/Issue",
      "issue_clear": "#/$defs/IssueClear",
      "ready": "#/$defs/Ready",
      "say": "#/$defs/Say",
      "state": "#/$defs/State"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Ready"
    },
    {
      "$ref": "#/$defs/State"
    },
    {
      "$ref": "#/$defs/Issue"
    },
    {
      "$ref": "#/$defs/IssueClear"
    },
    {
      "$ref": "#/$defs/Say"
    },
    {
      "$ref": "#/$defs/CancelSay"
    },
    {
      "$ref": "#/$defs/Debug"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ]
}
