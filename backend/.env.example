# Copy to backend/.env
ANTHROPIC_API_KEY=
# Optional LLM proxy (Platanus Hack): pass-through, ANTHROPIC_API_KEY is still required.
# ANTHROPIC_BASE_URL=https://llm.hack.platan.us/t/<tu-token>/anthropic
ANTHROPIC_MODEL=claude-opus-5-5
REDIS_URL=redis://127.0.0.1:6379/0
# Defaults to the arduino-cli bundled in Arduino IDE.app on macOS, else `arduino-cli` on PATH
# ARDUINO_CLI=/usr/local/bin/arduino-cli
# COMPILE_EAGER=true   # run compiles in-process without a Celery worker
# BUILD_DIR=backend/.builds      # where compile jobs and artifacts live (shared by api + worker)
# COMPILE_TIMEOUT_S=180
