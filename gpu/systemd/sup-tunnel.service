[Unit]
Description=Supervisor — Cloudflare tunnel → vLLM on 127.0.0.1:8001
After=network-online.target sup-vllm.service

[Service]
Type=simple
EnvironmentFile=%h/sup/env
# SUP_TUNNEL_TOKEN in ~/sup/env → named tunnel (stable URL); otherwise a quick tunnel (*.trycloudflare.com,
# new URL on every restart).
ExecStart=/bin/sh -c 'if [ -n "$SUP_TUNNEL_TOKEN" ]; then exec %h/.local/bin/cloudflared tunnel --no-autoupdate run --token "$SUP_TUNNEL_TOKEN"; else exec %h/.local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8001; fi'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
