# Circuito Vivo — static frontend (Vite build) served by nginx, /api proxied to the api service.
#   docker build -f docker/Dockerfile.web -t circuito-vivo-web .
FROM node:24-alpine AS build
ARG PNPM_VERSION=12.15.0
RUN npm install -g "pnpm@${PNPM_VERSION}"

WORKDIR /app/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# The catalog imports ../shared/{parts,boards}/*.json at build time.
COPY shared/ /app/shared/
COPY frontend/ ./
RUN pnpm exec vite build

FROM nginx:1.27-alpine
# Rendered to /etc/nginx/conf.d/default.conf at start (see the template for the variables).
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY docker/nginx-resolver.envsh /docker-entrypoint.d/15-resolver.envsh
COPY --from=build /app/frontend/dist /usr/share/nginx/html
# Only these are substituted, so nginx's own $host, $uri… stay untouched.
ENV PORT=80 \
    API_HOSTPORT=api:8000 \
    NGINX_ENVSUBST_FILTER="^(PORT|API_HOSTPORT|NGINX_RESOLVER)$"
EXPOSE 80
