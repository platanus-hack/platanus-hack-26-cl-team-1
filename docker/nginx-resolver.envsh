#!/bin/sh
# Sourced by the nginx image entrypoint before templates are rendered (20-envsubst-on-templates.sh),
# so the variables exported here reach nginx.conf.template.

# DNS server for the `resolver` directive (Docker: 127.0.0.11, Render: its private-network resolver).
if [ -z "${NGINX_RESOLVER:-}" ]; then
  NGINX_RESOLVER=$(awk '/^nameserver/ { ns = $2; if (ns ~ /:/) ns = "[" ns "]"; print ns; exit }' /etc/resolv.conf)
  export NGINX_RESOLVER="${NGINX_RESOLVER:-127.0.0.11}"
fi

# nginx's own resolver ignores the `search` domains in /etc/resolv.conf. Docker's DNS answers bare
# service names (api), but Render's private network only resolves bare names (circuito-vivo-api)
# through a search domain, so nginx gets "Host not found". A bare API host that the DNS server does
# not answer as is gets the first search domain under which it resolves, or else the first one
# (the API may still be starting; Render's private names live under its search domain).
dns_server="${NGINX_RESOLVER#[}"; dns_server="${dns_server%]}"  # nslookup wants IPv6 unbracketed
api_host="${API_HOSTPORT%:*}"
api_port="${API_HOSTPORT##*:}"
command -v nslookup >/dev/null 2>&1 || api_host="$api_host."  # can't check: leave it alone
case "$api_host" in
  *.*|\[*) api_host="${api_host%.}" ;;  # already qualified (or unchecked), or an IPv6 literal
  *)
    if ! nslookup "$api_host" "$dns_server" >/dev/null 2>&1; then
      search_domains=$(awk '/^search/ { for (i = 2; i <= NF; i++) print $i }' /etc/resolv.conf)
      qualified=""
      for domain in $search_domains; do
        if nslookup "$api_host.$domain" "$dns_server" >/dev/null 2>&1; then
          qualified="$api_host.$domain"
          break
        fi
      done
      if [ -z "$qualified" ]; then
        for domain in $search_domains; do qualified="$api_host.$domain"; break; done
      fi
      api_host="${qualified:-$api_host}"
    fi
    ;;
esac
export API_HOSTPORT="$api_host:$api_port"
echo "15-resolver: resolver=$NGINX_RESOLVER api=$API_HOSTPORT"
