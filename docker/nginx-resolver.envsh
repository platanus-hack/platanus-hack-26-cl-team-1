#!/bin/sh
# Sourced by the nginx image entrypoint before templates are rendered: exports the container's DNS
# server (Docker: 127.0.0.11, Render: its private-network resolver) for the `resolver` directive.
if [ -z "${NGINX_RESOLVER:-}" ]; then
  NGINX_RESOLVER=$(awk '/^nameserver/ { ns = $2; if (ns ~ /:/) ns = "[" ns "]"; print ns; exit }' /etc/resolv.conf)
  export NGINX_RESOLVER="${NGINX_RESOLVER:-127.0.0.11}"
fi
