# SPA + reverse proxy to the FastAPI service (compile API and the agent's SSE stream).
# Rendered at container start by the nginx image (envsubst on /etc/nginx/templates/*.template):
#   PORT            listen port (Render sets it; 80 by default)
#   API_HOSTPORT    FastAPI host:port (compose: api:8000 · Render: the private service's hostport)
#   NGINX_RESOLVER  DNS server, read from /etc/resolv.conf by 15-resolver.envsh
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 2m;  # POST /api/compile caps code at 100 KB; agent turns carry context

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # Resolve the API at request time (not once at startup): nginx boots even if the API is not up
  # yet, and follows the API to a new address after it redeploys.
  resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

  # Liveness of this container only (Render health check); does not depend on the API.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /api/ {
    set $api_upstream http://${API_HOSTPORT};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    # Server-Sent Events (POST /api/agent/turn): no buffering, long reads.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
