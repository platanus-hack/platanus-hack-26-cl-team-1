# Circuito Vivo — FastAPI (compile API + Claude agent). Build context: repo root.
#   docker build -f docker/Dockerfile.api -t circuito-vivo-api .
FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.13 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app/backend

# Dependencies first (cached layer), then the code.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY shared/ /app/shared/
COPY backend/app ./app

RUN useradd --create-home --uid 1000 app && mkdir -p /data/builds && chown -R app:app /data
USER app

# settings.py resolves the repo root to /app → SHARED_DIR=/app/shared by default.
ENV SHARED_DIR=/app/shared \
    BUILD_DIR=/data/builds

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/api/health' % os.environ.get('PORT', '8000'), timeout=2).status == 200 else 1)"

# Listens on $PORT when set: Render gives the private service PORT=10000 and publishes that port as its
# hostport (what the web service proxies to). Compose and CI leave it unset → 8000.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT:-8000}\" --proxy-headers --forwarded-allow-ips '*'"]
