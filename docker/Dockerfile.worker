# Circuito Vivo — Celery compile worker with arduino-cli + Uno and ESP32 cores. Build context: repo root.
#   docker build -f docker/Dockerfile.worker -t circuito-vivo-worker .
FROM python:3.11-slim

ARG ARDUINO_CLI_VERSION=1.4.1
ARG AVR_CORE=arduino:avr
ARG ESP32_CORE=esp32:esp32@3.3.8
ARG ESP32_INDEX=https://espressif.github.io/arduino-esp32/package_esp32_index.json

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.13 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

# arduino-cli (official install script) — reads these env vars instead of a config file.
RUN curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh \
    | BINDIR=/usr/local/bin sh -s "${ARDUINO_CLI_VERSION}"

# Python deps as root into /opt/venv (read-only for the app user).
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

RUN useradd --create-home --uid 1000 app && mkdir -p /opt/arduino /data/builds && chown -R app:app /opt/arduino /data
USER app

ENV ARDUINO_DIRECTORIES_DATA=/opt/arduino/data \
    ARDUINO_DIRECTORIES_USER=/opt/arduino/user \
    ARDUINO_DIRECTORIES_DOWNLOADS=/opt/arduino/staging \
    ARDUINO_BUILD_CACHE_PATH=/opt/arduino/cache \
    ARDUINO_BOARD_MANAGER_ADDITIONAL_URLS=${ESP32_INDEX} \
    ARDUINO_UPDATER_ENABLE_NOTIFICATION=false \
    ARDUINO_CLI=arduino-cli

# Cores + libraries baked into the image (no network needed at compile time).
RUN arduino-cli core update-index \
 && arduino-cli core install "${AVR_CORE}" "${ESP32_CORE}" \
 && arduino-cli lib update-index \
 && arduino-cli lib install Servo ESP32Servo \
 && rm -rf /opt/arduino/staging

# Warm the core cache so the first real compile of each board is faster.
RUN mkdir -p /tmp/warm/sketch \
 && printf 'void setup(){pinMode(2,OUTPUT);}\nvoid loop(){digitalWrite(2,HIGH);delay(100);digitalWrite(2,LOW);delay(100);}\n' > /tmp/warm/sketch/sketch.ino \
 && arduino-cli compile --fqbn arduino:avr:uno /tmp/warm/sketch \
 && arduino-cli compile --fqbn esp32:esp32:esp32c6 /tmp/warm/sketch \
 && rm -rf /tmp/warm /opt/arduino/cache/sketches

COPY --chown=app:app shared/ /app/shared/
COPY --chown=app:app backend/app ./app

ENV SHARED_DIR=/app/shared \
    BUILD_DIR=/data/builds

CMD ["celery", "-A", "app.compile.celery_app", "worker", "--loglevel=info", "--concurrency=2", "--without-gossip", "--without-mingle"]
