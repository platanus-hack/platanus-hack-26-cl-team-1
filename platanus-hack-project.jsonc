{
  // Your project's name, as it will appear on the voting page.
  "project-name": "Cortafuego",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "Un simulador del incendio del 2 de febrero de 2024 en Viña del Mar sobre el terreno, el viento y las calles reales: cambia el clima, dibuja cortafuegos o adelanta la alerta y mira cuántos hogares alcanzan a salir.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "Cortafuego ayuda a decidir qué mejorar hoy para enfrentar mejor los incendios de mañana. Mediante simulaciones detalladas del avance del fuego y la evacuación, permite evaluar dónde construir cortafuegos, qué rutas reforzar, dónde abrir salidas de emergencia y cuándo activar una alerta. Combina datos abiertos reales de relieve, vegetación, viviendas, calles y clima para comparar escenarios y estimar cómo cada intervención cambia la exposición de los hogares y sus posibilidades de evacuar a tiempo. La reconstrucción del megaincendio de Viña del Mar, Quilpué y Villa Alemana sirve como caso de estudio, contrastado con la cicatriz de Sentinel-2 y los focos satelitales de la NASA. El objetivo es transformar esas simulaciones en evidencia para priorizar inversiones, mejorar planes de evacuación y preparar comunidades antes de la próxima emergencia.",

  // Public URL where your project is deployed and running.
  // Must be a valid URL, for example: https://my-project.vercel.app
  // If your project is an app, put the download link here instead
  // (for example, a URL to download an APK).
  "deploy-url": "https://cortafuego.app"
}
