{
  "id": "uno",
  "name": "Arduino Uno R3",
  "mcu": "ATmega328P",
  "fqbn": "arduino:avr:uno",
  "description": "La placa clásica para aprender: microcontrolador ATmega328P a 16 MHz, lógica de 5 V, 14 pines digitales (6 con PWM) y 6 entradas analógicas.",
  "logicVoltage": 5,
  "vih": 3.0,
  "vil": 1.5,
  "outputOhms": 25,
  "pullupOhms": 35000,
  "pinCurrent": {
    "recommendedmA": 20,
    "maxmA": 40
  },
  "totalCurrentmA": 200,
  "adc": {
    "bits": 10,
    "maxValue": 1023,
    "vref": 5
  },
  "pwm": {
    "maxValue": 255,
    "freqHz": 490
  },
  "supply": {
    "usbVolts": 5,
    "usbMaxmA": 500,
    "rails": [
      {
        "pin": "5V",
        "volts": 5,
        "maxmA": 500,
        "sourceOhms": 0.3,
        "label": "5V (USB)"
      },
      {
        "pin": "3V3",
        "volts": 3.3,
        "maxmA": 50,
        "sourceOhms": 2.0,
        "label": "3.3V"
      }
    ]
  },
  "headerContact": "female",
  "conflicts": [
    {
      "when": "servo",
      "disablesPwm": [
        "D9",
        "D10"
      ],
      "message": "En el Arduino Uno, usar un servo desactiva el PWM (analogWrite) en los pines 9 y 10."
    },
    {
      "when": "tone",
      "disablesPwm": [
        "D3",
        "D11"
      ],
      "message": "En el Arduino Uno, tone() desactiva el PWM en los pines 3 y 11."
    }
  ],
  "maxConcurrentTones": 1,
  "toolchain": {
    "core": "arduino:avr",
    "minCoreVersion": "1.8.0",
    "libraries": [
      {
        "name": "Servo"
      }
    ],
    "artifactSuffix": ".ino.hex"
  },
  "onboard": [
